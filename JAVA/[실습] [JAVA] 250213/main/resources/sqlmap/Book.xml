<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org/DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="practice.booksearch">
    <select id="select" parameterType="String" resultType="vo.BookVO">
        <![CDATA[
            SELECT bisbn, btitle, bprice, bauthor
            FROM book
            WHERE btitle LIKE '%' || #{keyword} || '%'
        ]]>
    </select>

    <delete id="delete" parameterType="String">
        <![CDATA[
        DELETE FROM book
        WHERE bisbn = #{bisbn}
        ]]>
    </delete>

    <insert id="insert" parameterType="vo.BookVO">
        <![CDATA[
        INSERT INTO book (bisbn, btitle, bprice, bauthor)
        VALUES (#{bisbn}, #{btitle}, #{bprice}, #{bauthor})
        ]]>
    </insert>

    <update id="update" parameterType="map">
        <![CDATA[
        UPDATE book
        SET ${column} = #{newValue}
        WHERE bisbn = #{bisbn}
        ]]>
    </update>
</mapper>