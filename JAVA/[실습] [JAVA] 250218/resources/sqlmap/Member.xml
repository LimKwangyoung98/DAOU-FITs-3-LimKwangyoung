<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org/DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="servlet.member">
    <select id="login" parameterType="map" resultType="org.example.boardproject.vo.MemberVO">
        <![CDATA[
        SELECT member_id, password, name
        FROM membertbl
        WHERE member_id = #{member_id}
          AND password = #{password}
        ]]>
    </select>
</mapper>