<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org/DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="servlet.user">
    <select id="login" parameterType="map" resultType="org.example.postproject.vo.UserVO">
        <![CDATA[
        SELECT user_id AS userId, password, name
        FROM users
        WHERE user_id = #{userId}
          AND password = #{password}
        ]]>
    </select>
</mapper>